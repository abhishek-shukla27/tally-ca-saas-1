# Tally Sync Desktop Client – Environment Variables
# Copy this file to .env and fill in real values.

# URL of the local TallyPrime HTTP server (default: localhost:9000)
TALLY_URL=http://localhost:9000

# Cloud Backend upload endpoint
BACKEND_UPLOAD_URL=https://api.tally-ca-saas.example.com/api/v1/sync/upload

# Unique token for this client device (issued by the CA portal on onboarding)
CLIENT_TOKEN=REPLACE_ME_WITH_REAL_TOKEN

# Tally request timeout in seconds
TALLY_TIMEOUT=30

# Financial year date range for voucher extraction
SYNC_FROM_DATE=20240401
SYNC_TO_DATE=20250331

